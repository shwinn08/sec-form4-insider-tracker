# Copy to .env and fill in your real details.
#
# The SEC requires automated traffic to identify itself. Format they ask for:
#   "Sample Company Name AdminContact@example.com"
# In practice: something that lets a human at the SEC contact you if your
# scraper misbehaves. A fake or missing value gets your IP blocked.
SEC_USER_AGENT="Your Name Form4Scraper your.email@example.com"
